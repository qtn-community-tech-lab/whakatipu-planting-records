# Public and read-only: commit this file. Anyone who clones the repo reads live planting data with no setup.
# The publishable key can read every live row and every total, and nothing else: the database refuses all writes from it.
# The secret key never goes here. It belongs in .env.local (ignored by git), and only the import scripts use it.
NEXT_PUBLIC_SUPABASE_URL=https://knlzslvuimjguqkxtneb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3ZveZ2Bq9Kf-hg7gcIyAPg_PAi8oUet

# Where the pages read from: supabase (live, read-only) or csv (the files in docs/planning/prototype).
# Every page shows which one it is reading, top right.
WRT_DATA_SOURCE=supabase
