# You don't need this to run the app: the public URL and read-only key are already in .env.
# Copy it to .env.local only to run the import scripts, which need the secret key.
# .env.local is ignored by git and overrides .env on your machine.

# Only for scripts/import-workbook.ts. It passes the access rules: never use it in the app or commit it.
SUPABASE_SECRET_KEY=<secret key from the project's API settings>
