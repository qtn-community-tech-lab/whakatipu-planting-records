# Copy this file to .env.local for local development.
# After starting Supabase, run `supabase status` and copy its API URL and public key.
# The public key may be labelled publishable or anon; either works here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-local-publishable-or-anon-key>

# dev:local starts Supabase but does not set these variables automatically.
# Restart Next.js after changing .env.local. Use public keys, never service-role keys.
# For a hosted project, replace both values with those from its Dashboard.
# Full setup: docs/supabase-setup.md
