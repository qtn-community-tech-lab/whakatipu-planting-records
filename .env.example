# Supabase clients use these public settings; database access rules guard the data.
# Setup: docs/supabase-setup.md. Pages currently still read the CSV repository.
# Local values come from `supabase status`; hosted values come from the Dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from the project's API settings>
