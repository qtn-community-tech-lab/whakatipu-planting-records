# Copy to .env.local for local development. See README.md for the setup steps.
# .env.local is ignored by git and overrides .env on your machine.
# Run npm run supabase:start, then copy the local keys from its output.
# Show them again with: npx --yes supabase@2.121.0 status

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local publishable key, or anon key>
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Auth email: local Supabase captures messages at http://127.0.0.1:54324.
# Production uses Resend SMTP configured in hosted Supabase, not in Next.js.
# Store the Resend API key as the SMTP password there; no RESEND_API_KEY is needed here.

# Only for import-workbook and import-pins. Bypasses row-level security.
# Never expose this in the app, prefix it with NEXT_PUBLIC_, or commit it.
SUPABASE_SECRET_KEY=<local secret key, or service_role key>
