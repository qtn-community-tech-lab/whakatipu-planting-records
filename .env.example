# The app reads and writes through Supabase directly. Both are public: the access rules guard the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from the project's API settings>

# Only for scripts/import-workbook.ts. It passes the access rules: never use it in the app or commit it.
SUPABASE_SECRET_KEY=<secret key from the project's API settings>
