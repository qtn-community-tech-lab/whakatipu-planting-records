# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env holds only the public Supabase URL and read-only key, so it is committed.
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent dev servers
/.next-*/

# Client documentation and workbook-derived data (restore locally from RESTORE_DOCS.md)
/docs/

# planting events saved locally until Supabase is connected (lib/wrt/events/json-event-store.ts)
/data/local/

# Supabase CLI cache
supabase/.temp/

# video renders: frames and the renderer's own packages (hundreds of MB)
/docs/motion/render/out/
/docs/motion/render/node_modules/
