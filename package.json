    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^6.0.196",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
