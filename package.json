{
  "name": "wrt-planting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "import-workbook": "tsx scripts/import-workbook.ts",
    "seed-species": "tsx scripts/seed-species.ts",
    "import-pins": "tsx scripts/import-pins.ts",
    "supabase:start": "npx --yes supabase@2.121.0 start && npm run db:migrate",
    "supabase:stop": "npx --yes supabase@2.121.0 stop",
    "db:migrate": "npx --yes supabase@2.121.0 migration up --local",
    "db:types": "npx --yes supabase@2.121.0 gen types typescript --project-id tjyigjsadcepjumrshnb --schema public > db/database.types.ts && npx --yes prettier@3.9.10 --write db/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.303",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
